# Copie para .env na VM e preencha. Nunca commite o .env.

# Domínio público; o Caddy emite o certificado HTTPS sozinho. O app também o usa nos links que saem dele
# (lembrete de disponibilidade: https://DOMINIO/disponibilidade).
DOMINIO=escala.exemplo.com.br

# Imagem publicada pelo CI no GitHub Container Registry.
ESCALA_IMAGEM=ghcr.io/joao-gabriel-meneses/escala:latest

# Autonomous Database. A wallet descompactada fica em ./wallet (montada em /wallet).
# O alias (<banco>_tp) está no tnsnames.ora da wallet.
DB_URL=jdbc:oracle:thin:@escala_tp?TNS_ADMIN=/wallet
DB_USUARIO=ESCALA_APP
DB_SENHA=

# Admin criado na primeira subida (senha com pelo menos 8 caracteres).
# Obrigatório enquanto o banco não tiver admin: sem ele a aplicação não sobe.
ESCALA_ADMIN_NOME=
ESCALA_ADMIN_EMAIL=
ESCALA_ADMIN_SENHA=

# Assina o cookie "continuar conectado". Gere com: openssl rand -base64 32
ESCALA_CHAVE_LEMBRAR_ME=
