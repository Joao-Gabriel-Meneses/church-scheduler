# Copie para .env na VM (/opt/escala/.env, chmod 600) e preencha. Nunca commite o .env.

# Faz o `docker compose` usar o compose.prod.yaml sem precisar de -f.
COMPOSE_FILE=compose.prod.yaml

# Tag da imagem no GHCR: o SHA completo do commit da main (git rev-parse HEAD). Nunca latest.
# Rollback: volte para a tag anterior e rode docker compose up -d.
ESCALA_TAG=

# Token do túnel (Cloudflare Zero Trust → Networks → Tunnels → o túnel → token do conector).
CLOUDFLARE_TUNNEL_TOKEN=

# Domínio público. O app o usa nos links que saem dele (https://DOMINIO/disponibilidade).
DOMINIO=escala.ibrp.com.br

# Autonomous Database. A wallet descompactada fica em ./wallet (montada em /wallet, somente leitura).
# O alias (<banco>_tp) está no tnsnames.ora da wallet.
DB_URL=jdbc:oracle:thin:@escala_tp?TNS_ADMIN=/wallet
DB_USUARIO=ESCALA_APP
DB_SENHA=

# Admin criado na primeira subida (senha com pelo menos 8 caracteres).
# Obrigatório enquanto o banco não tiver admin: sem ele a aplicação não sobe.
ESCALA_ADMIN_NOME=
ESCALA_ADMIN_EMAIL=
ESCALA_ADMIN_SENHA=

# Assina o cookie "continuar conectado". Gere com: openssl rand -base64 32
ESCALA_CHAVE_LEMBRAR_ME=
